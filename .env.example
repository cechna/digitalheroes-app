# ==============================================================================
# DIGITAL HEROES - Configurazione Variabili d'Ambiente
# ==============================================================================

# SUPABASE (Database PostgreSQL, Autenticazione & Storage dei file)
# In modalità sviluppo locale senza credenziali esterne, l'app utilizza
# automaticamente il repository demo locale senza errori di connessione.
NEXT_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tuo-anon-key-pubblico
SUPABASE_SERVICE_ROLE_KEY=tuo-service-role-key-privato

# SERVIZIO EMAIL TRANSAZIONALE
# Opzioni consentite per EMAIL_PROVIDER: 'mock' (default per sviluppo/test), 'resend', 'console'
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=Digital Heroes <notifiche@digitalheroes.it>

# LIMITI UPLOAD FILE (in byte, default 25 MB = 26214400)
MAX_FILE_SIZE_BYTES=26214400

# FUSO ORARIO PREDEFINITO
TZ=Europe/Rome
