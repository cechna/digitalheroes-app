# ==============================================================================
# DIGITAL HEROES - Configurazione per la PUBBLICAZIONE IN PRODUZIONE
# ==============================================================================

# URL pubblico del sito di produzione (usato per sitemap e link email)
NEXT_PUBLIC_SITE_URL=https://digital-heroes.net

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database PostgreSQL, Auth & File Storage)
# ------------------------------------------------------------------------------
# Recupera questi valori dalla dashboard Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<TUO-PROJECT-REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. EMAIL TRANSAZIONALE (Resend o SMTP)
# ------------------------------------------------------------------------------
# In produzione impostare 'resend' per inviare reali email di conferma e notifica
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_123456789abcdef...
EMAIL_FROM=Digital Heroes <notifiche@digital-heroes.net>

# ------------------------------------------------------------------------------
# 3. SICUREZZA & AMBIENTE DI PRODUZIONE
# ------------------------------------------------------------------------------
NODE_ENV=production

# Disabilita il selettore rapido dei ruoli nella navbar (impostare 'true' solo se vuoi mantenerlo in staging/anteprima)
NEXT_PUBLIC_ENABLE_DEMO_SWITCHER=false
ENABLE_DEMO_SWITCHER=false

# Disabilita l'auto-login automatico da sviluppatore (obbliga il login reale)
DISABLE_DEV_AUTO_LOGIN=true

# Limite dimensione file caricabili (in byte: 25 MB = 26214400)
MAX_FILE_SIZE_BYTES=26214400

# Fuso orario obbligatorio per l'applicazione
TZ=Europe/Rome
